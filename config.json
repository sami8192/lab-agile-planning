{
  "criteria": {
    "min_screen_inches": 6.5,
    "min_storage_gb": 256,
    "conditions": ["new"],
    "models": ["Air", "16 Plus", "Pro Max"],
    "exclude_models": [],
    "require_unlocked": true,
    "allowed_carriers": ["unlocked", "t-mobile"],
    "allow_unknown_carrier": true,
    "exclude_new_line_offers": true,
    "max_price": null,
    "currency": "USD",
    "require_in_stock": true,
    "allow_unknown_models": false
  },
  "alerts": {
    "min_drop_percent": 2.0,
    "min_drop_amount": 10.0,
    "baseline": "best",
    "notify_cooldown_hours": 12,
    "notify_on_first_seen": false,
    "group_notifications": true,
    "max_items_per_notification": 5
  },
  "sources": [
    {
      "type": "bestbuy",
      "name": "bestbuy",
      "enabled": true,
      "api_key": "${BESTBUY_API_KEY}",
      "search": "iphone"
    },
    {
      "type": "ebay",
      "name": "ebay-air",
      "enabled": true,
      "client_id": "${EBAY_CLIENT_ID}",
      "client_secret": "${EBAY_CLIENT_SECRET}",
      "query": "Apple iPhone Air 256GB unlocked",
      "marketplace": "EBAY_US"
    },
    {
      "type": "ebay",
      "name": "ebay-16-plus",
      "enabled": true,
      "client_id": "${EBAY_CLIENT_ID}",
      "client_secret": "${EBAY_CLIENT_SECRET}",
      "query": "Apple iPhone 16 Plus 256GB unlocked",
      "marketplace": "EBAY_US"
    },
    {
      "type": "ebay",
      "name": "ebay-pro-max",
      "enabled": true,
      "client_id": "${EBAY_CLIENT_ID}",
      "client_secret": "${EBAY_CLIENT_SECRET}",
      "query": "Apple iPhone Pro Max 256GB unlocked",
      "marketplace": "EBAY_US"
    },
    {
      "type": "custom_html",
      "name": "apple-air",
      "enabled": false,
      "url": "https://www.apple.com/shop/buy-iphone/iphone-air",
      "title": "Apple iPhone Air 256GB",
      "storage_gb": 256,
      "carrier": "unlocked",
      "condition": "new"
    },
    {
      "type": "custom_html",
      "name": "apple-16-plus",
      "enabled": false,
      "url": "https://www.apple.com/shop/buy-iphone/iphone-16",
      "title": "Apple iPhone 16 Plus 256GB",
      "storage_gb": 256,
      "carrier": "unlocked",
      "condition": "new"
    },
    {
      "type": "custom_html",
      "name": "apple-17-pro-max",
      "enabled": false,
      "url": "https://www.apple.com/shop/buy-iphone/iphone-17-pro",
      "title": "Apple iPhone 17 Pro Max 256GB",
      "storage_gb": 256,
      "carrier": "unlocked",
      "condition": "new"
    },
    {
      "type": "sample",
      "name": "demo",
      "enabled": false
    }
  ],
  "notifiers": [
    {
      "type": "ntfy",
      "name": "phone",
      "enabled": true,
      "topic": "${NTFY_TOPIC}",
      "server": "https://ntfy.sh"
    },
    {
      "type": "console",
      "name": "stdout",
      "enabled": true
    }
  ],
  "state_file": "state/prices.json",
  "interval_seconds": 900
}
